# Base URL of the Tabaakhuh backend API (admin-dashboard-api.md, Phase 1)
VITE_API_BASE_URL=https://your-host/api/v1

# Cloudinary — Settings > Store info logo/icon uploads. The admin picks a file,
# the dashboard uploads it straight to Cloudinary (unsigned), and only the
# returned secure_url is persisted via PUT /admin/settings.
#   CLOUD_NAME     – the account's cloud name
#   UPLOAD_PRESET  – an *unsigned* upload preset (Settings > Upload in Cloudinary)
#   FOLDER         – optional target folder for the assets
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=tabaakhuh/settings
